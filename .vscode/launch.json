{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/racing-culture-stats-api-master/RacingCultureStatsAPI/bin/Debug/net5.0/RacingCultureStatsAPI.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/racing-culture-stats-api-master/RacingCultureStatsAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Chrome (React)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/racing-culture-frontend-master/client/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": [".NET Core Launch (API)", "Launch Chrome (React)"]
    }
  ]
}
